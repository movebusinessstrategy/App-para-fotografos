{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "account_id": "e60d496db278f00f5fa0300df1e76f35",
  "name": "estudio-gi-pitori-marketing-bridge",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "BRIDGE_ENABLED": "false",
    "SITE_ORIGIN": "https://www.gipitorifotografias.com.br"
  },
  "secrets": {
    "required": [
      "CRM_INGEST_URL",
      "MARKETING_SITE_KEY_ID",
      "MARKETING_SITE_SIGNING_SECRET",
      "TURNSTILE_SECRET_KEY"
    ]
  },
  "ratelimits": [
    {
      "name": "MARKETING_BRIDGE_RATE_LIMITER",
      "namespace_id": "2026082801",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
