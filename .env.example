# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=https://ais-dev-jbfxioz6xxtwpmmnwcqx3n-99437518295.us-east5.run.app

# Remotion + AWS Lambda
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
REMOTION_AWS_FUNCTION_NAME=
REMOTION_AWS_SERVE_URL=

# WhatsApp Cloud API (Meta) — Embedded Signup
# META_APP_ID, META_APP_SECRET, META_WA_CONFIG_ID configurados no painel Meta
META_APP_ID=
META_APP_SECRET=
# Configuration ID do Embedded Signup v4 com Coexistence habilitado
META_WA_CONFIG_ID=1690598005448884
VITE_META_APP_ID=
# Configuration ID do Embedded Signup v4 com Coexistence habilitado
VITE_META_WA_CONFIG_ID=1690598005448884

# Chave AES-256-GCM (32 bytes hex) que cifra os access_tokens em repouso.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Se vazia, tokens ficam plaintext no DB (ok em dev, NÃO em produção).
WA_TOKEN_ENCRYPTION_KEY=

# Token compartilhado entre seu app e o painel Meta pra verificar o webhook.
# Cadastre o MESMO valor no painel "Configuration > Webhooks" do app Meta.
WA_WEBHOOK_VERIFY_TOKEN=fotomove_webhook_2026

# Liga a verificação HMAC do webhook (sha256 do body com META_APP_SECRET).
# Em produção SEMPRE true. Defina 'false' SÓ em dev local quando testar com Postman.
WA_WEBHOOK_VERIFY_SIGNATURE=true
