# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=https://ais-dev-jbfxioz6xxtwpmmnwcqx3n-99437518295.us-east5.run.app

# Remotion + AWS Lambda
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
REMOTION_AWS_FUNCTION_NAME=
REMOTION_AWS_SERVE_URL=

# WhatsApp Cloud API (Meta) — Embedded Signup
# META_APP_ID, META_APP_SECRET, META_WA_CONFIG_ID configurados no painel Meta
META_APP_ID=
META_APP_SECRET=
# Configuration ID do Embedded Signup v4 com Coexistence habilitado
META_WA_CONFIG_ID=1690598005448884
VITE_META_APP_ID=
# Configuration ID do Embedded Signup v4 com Coexistence habilitado
VITE_META_WA_CONFIG_ID=1690598005448884

# Chave AES-256-GCM (32 bytes hex) que cifra os access_tokens em repouso
# (WhatsApp E Mercado Pago). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Em produção é OBRIGATÓRIA: sem ela, o app recusa salvar tokens de
# pagamento (não grava em plaintext) e desabilita login de cliente na galeria.
WA_TOKEN_ENCRYPTION_KEY=

# Chave HMAC (32 bytes hex) que assina a sessão de login da CLIENTE na
# galeria pública. Se vazia, cai pra WA_TOKEN_ENCRYPTION_KEY. Em produção,
# se nenhuma das duas existir, o login da galeria fica desabilitado (em vez
# de usar uma chave fraca derivável). Gere igual à de cima.
GALLERY_SESSION_KEY=

# OAuth Mercado Pago (cada estúdio conecta a própria conta). Cadastre o app
# em mercadopago.com.br/developers e ponha aqui. MP_REDIRECT_URI tem que ser
# idêntico ao configurado no painel do MP.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=https://crmtrilha.com.br/api/oauth/mp/callback

# Token compartilhado entre seu app e o painel Meta pra verificar o webhook.
# Cadastre o MESMO valor no painel "Configuration > Webhooks" do app Meta.
WA_WEBHOOK_VERIFY_TOKEN=fotomove_webhook_2026

# Liga a verificação HMAC do webhook (sha256 do body com META_APP_SECRET).
# Em produção SEMPRE true. Defina 'false' SÓ em dev local quando testar com Postman.
WA_WEBHOOK_VERIFY_SIGNATURE=true

# DEPRECATED — era hipótese errada (xd_arbiter é subdomínio interno do JS SDK,
# nunca foi aceito como redirect_uri em produção). Mantido só pra não quebrar
# deploys antigos; o fluxo atual usa launcher_url vindo do frontend.
# META_FB_XD_ARBITER_URL=

# URL pública do app (sem trailing slash). Usada como allowlist extra pra
# launcher_url no exchange-token. Exemplo: https://app.exemplo.com
APP_PUBLIC_URL=

# --- Supabase (cliente + service role) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Backend público (Render) ---
# URL do server.ts pra o frontend chamar via authFetch
SERVER_URL=

# --- LLM providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- WhatsApp provider switch ---
# Valores aceitos: 'meta' (Cloud API oficial) | 'evolution' (Evolution API self-hosted)
WHATSAPP_PROVIDER=meta

# --- Evolution API (alternativa à Meta Cloud) ---
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# --- Asaas (cobrança/assinaturas) ---
# ASAAS_ENV: 'sandbox' | 'production'
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=

# --- Resend (e-mails da galeria de fotos) ---
# Chave da API do Resend (https://resend.com/api-keys). Sem ela os e-mails
# da galeria são pulados silenciosamente (o resto do fluxo funciona).
# RESEND_API_KEY=
# Remetente default verificado no Resend, ex.: "Estúdio <galeria@seudominio.com>".
# Se vazio, usa onboarding@resend.dev (só serve pra testes).
# RESEND_FROM=
