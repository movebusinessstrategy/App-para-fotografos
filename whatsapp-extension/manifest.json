{
  "manifest_version": 3,
  "name": "FocalPoint para WhatsApp",
  "version": "1.3.9",
  "description": "Pipeline de vendas integrado ao WhatsApp Web",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://app-para-fotografos.onrender.com/*",
    "https://app-para-fotografos.vercel.app/*",
    "https://*.supabase.co/*",
    "http://localhost:3000/*",
    "http://localhost:5173/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js", "agente.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
