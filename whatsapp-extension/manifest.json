{
  "manifest_version": 3,
  "name": "CRM Trilha para WhatsApp",
  "version": "1.3.25",
  "description": "Pipeline de vendas integrado ao WhatsApp Web",
  "icons": {
    "16": "icons/icon.png",
    "32": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon.png",
      "32": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    },
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://app-para-fotografos.onrender.com/*",
    "https://app-para-fotografos.vercel.app/*",
    "https://*.supabase.co/*",
    "http://localhost:3000/*",
    "http://localhost:5173/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js", "agente.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["sounds/venda-realizada.webm"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
